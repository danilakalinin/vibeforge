{
  "identifier": "default",
  "description": "Default capabilities for VibeForge",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-effects",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir"
  ]
}
